# ============================================================
#  .gitignore —— 混合策略：顶层白名单 + 目录内黑名单
#
#  第 1 段  顶层全挡：根目录下冒出任何东西，默认都不入库
#  第 2 段  显式放行：只放行本项目自己的交付物
#  第 3 段  产物黑名单：白名单目录内部，挡掉一切可再生的构建产物
#
#  ⚠️ 顺序不能动。gitignore 是「后面的规则覆盖前面的」，
#     所以 /* 必须在最前，! 放行在中间，产物模式放最后。
#     想让 !/xxx 生效，xxx 的父目录必须也被放行（父目录被挡住时，
#     里面的文件再写 ! 也救不回来）。
#
#  ⚠️ 以后新增顶层文件/目录，必须来第 2 段补一行：
#         新增文件 → !/文件名.md
#         新增目录 → !/目录名/         ← 结尾的斜杠别漏
#     漏了的后果是 git status 里「什么都不显示」——白名单的漏报
#     是安静的，不会报错。新建完目录顺手 git status 确认一下。
# ============================================================


# ---------- 第 1 段：顶层全挡 ----------
/*


# ---------- 第 2 段：放行本项目自己的东西 ----------
!/.gitignore
!/.gitattributes
!/README.md
!/comprehensive_8ask/
!/docs/

# 基础实验目录（LFSR 或其他）重建后，在这里补一行，例如：
#     !/basic_lfsr/


# ============================================================
#  第 3 段：目录内黑名单
#  下面这些模式都不带前导斜杠（写 "*.jou" 而非 "/*.jou"），
#  因此在任意深度都生效，正好覆盖第 2 段放行的那些目录。
# ============================================================

# 老师的参考资料：课件 + 手册 PDF，只读，不是交付物。
# （在顶层已被 /* 挡住，这里再写一遍是为了万一以后被挪进子目录）
课件一/
课件二/
_ppt_txt/
相关资料/
# 万一要单独追踪里面某个小文件：git add -f 相关资料/xxx

# ------------------------------------------------------------
#  Vivado / ISE 构建产物
#  原则：提交 .xpr + .srcs 源码 + .xci 的 IP 配置 + .coe 系数
#        忽略一切可再生的缓存、网表、仿真输出
# ------------------------------------------------------------
*.jou
*.log
*.str
*.pbxproj
*.backup
.Xil/
webtalk*.jou
webtalk*.log
vivado_*.backup.*
*.xpr.bak

# 工程内的可再生工作目录（Vivado 自动生成）
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/
*.srcs/**/ip/**/.Xil/

# 综合 / 实现 / 仿真输出
*.dcp
*.dcp.bak
*.bit
*.bin
*.ltx
*.rbd
*.nky
*.xsa
xsim.dir/
*.wdb
*.wcfg
*.vcd
*.pbw

# XSim 独立仿真流程（xvlog/xelab/xsim）的中间产物
#   *.pb 是编译/精化的内部索引，可随时重建
#   .sim_work/ 是 scripts/run_sim.sh 使用的工作目录
*.pb
.sim_work/

# 若走非工程模式（Tcl 批处理）产生的脚本日志
*.tcl.bak

# ------------------------------------------------------------
#  MATLAB
# ------------------------------------------------------------
*.asv
*.autosave
slprj/
*.slxc

# ------------------------------------------------------------
#  报告 / Office 临时文件
# ------------------------------------------------------------
~$*.docx
~$*.doc
~$*.xlsx
~$*.pptx
*.tmp

# ------------------------------------------------------------
#  操作系统与编辑器
# ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
